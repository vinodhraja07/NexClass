# ==============================================================================
# NexClass Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the production deployment:
#   cp .env.example .env
#
# CRITICAL SECURITY WARNING:
# In production mode (NODE_ENV=production), the API will refuse to start and
# will exit with an error if JWT_SECRET is left as the development default
# ("nexclass-development-secret-change-me"). You MUST supply a secure, cryptographically
# random secret key (minimum 32 characters) for JWT_SECRET.
# ==============================================================================

# Node Environment ("production", "development", "test")
NODE_ENV=production

# Exposed Service Ports (Host bindings)
WEB_PORT=3000
API_PORT=4000
MONGO_PORT=27017
REDIS_PORT=6379

# Allowed Client Origins for CORS (comma-separated list of origins)
CLIENT_ORIGIN=http://localhost:3000,http://localhost:80,http://localhost:5173

# Database & Cache Configurations (Internal Docker network URLs)
MONGODB_URI=mongodb://mongodb:27017/nexclass
MONGODB_DB_NAME=nexclass
REDIS_URL=redis://redis:6379

# Authentication & Security
# WARNING: Change this to a secure random string (at least 32 characters) before deploying.
# Generate a secure key with: openssl rand -base64 32
JWT_SECRET=nexclass_production_jwt_secret_replace_with_strong_key_32chars
JWT_EXPIRES_IN=7d

# Meeting Recordings Storage Path (Volume mount inside container)
RECORDINGS_PATH=/app/recordings
RECORDINGS_DIR=/app/recordings

# WebRTC STUN/TURN ICE Servers
# Multiple STUN servers can be comma-separated
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_PASSWORD=

# Automatic Speech Recognition (ASR)
# Supported options: browser (Web Speech API), remote-asr
ASR_PROVIDER=browser
ASR_API_KEY=
ASR_API_URL=

# Multilingual Translation
# Supported options: none, google, deepl, indictrans2, generic-http
TRANSLATION_PROVIDER=none
TRANSLATION_API_KEY=
TRANSLATION_API_URL=
TRANSLATION_MODEL=indic-trans2

# Text-to-Speech (TTS)
# Supported options: google-translate-tts-fallback (zero-key fallback with Odia phonetic alignment), google-tts, azure-tts, generic-tts, browser, none
TTS_PROVIDER=google-translate-tts-fallback
TTS_API_KEY=
TTS_API_URL=

# Technical Terminology Engine
# Supported options: none, local, remote
TERM_ASSIST_PROVIDER=none
TERM_ASSIST_API_KEY=

# Classroom Access & Rate Limiting
ALLOW_GUEST_JOIN=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
