{
  "name": "nexclass",
  "private": true,
  "version": "1.0.0",
  "description": "NexClass - multilingual real-time virtual classroom",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm run build -w @nexclass/shared && npm run build -w @nexclass/terminology",
    "build": "npm run build:shared && npm run build -w @nexclass/api && npm run build -w @nexclass/web",
    "dev": "npm run build:shared && concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @nexclass/api",
    "dev:web": "npm run dev -w @nexclass/web",
    "typecheck": "npm run typecheck -w @nexclass/api && npm run typecheck -w @nexclass/web",
    "test": "npm run test -w @nexclass/api",
    "lint": "npm run lint -w @nexclass/api && npm run lint -w @nexclass/web",
    "setup": "npm install"
  },
