# Copy to `.env` (or `.env.local`) and adjust. Everything has a workable
# default: with no Mongo/Redis and no provider keys, NexClass runs with an
# in-memory document store and clearly reports translation/voice as
# "unconfigured" instead of faking results.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Persistence (optional - falls back to an in-memory store when absent)
MONGODB_URI=mongodb://127.0.0.1:27017/nexclass
MONGODB_DB_NAME=nexclass
REDIS_URL=redis://127.0.0.1:6379

# Sessions - MUST be changed in production (the server refuses to boot
# in production with the development default).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# WebRTC ICE servers
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN_SERVER_URL=turn:turn.example.com:3478?transport=udp
# TURN_USERNAME=
# TURN_PASSWORD=

# Speech recognition. "browser" uses the speaker's Web Speech API.
# ASR_PROVIDER=browser|generic-http
# ASR_API_KEY=
# ASR_API_URL=

# Machine translation. "none" keeps captions original-only and reports
# every translation as failed (never fabricated). Options:
# none | google | deepl | indictrans2 (self-hosted) | generic-http
TRANSLATION_PROVIDER=none
# TRANSLATION_API_KEY=
# TRANSLATION_API_URL=
# TRANSLATION_MODEL=indic-trans2

# Voice rendering. "browser" uses each student's speechSynthesis.
# TTS_PROVIDER=browser|google-tts|azure-tts|generic-tts
# TTS_API_KEY=
# TTS_API_URL=

# Optional LLM assist for the terminology engine (verified equivalents of
# technical terms). Without it the engine uses its built-in verified
# glossary plus transliteration fallbacks.
TERM_ASSIST_PROVIDER=none
# TERM_ASSIST_API_KEY=

# Guest joining is enabled by default; set to false to require accounts.
ALLOW_GUEST_JOIN=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
